<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    tools:context=".MainActivity">

    <!-- Fixed Bottom Navigation -->
    <LinearLayout
        android:id="@+id/ll_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_main"
        android:baselineAligned="false"

        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_nav_focus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/accent_pink"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/focus"
                android:textColor="@color/accent_pink"
                android:textSize="12sp"
                app:drawableTopCompat="@drawable/ic_power"
                android:drawablePadding="0dp"
                app:drawableTint="@color/accent_pink" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_nav_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/text_gray"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/tasks"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:drawableTopCompat="@drawable/ic_work"
                android:drawablePadding="0dp"
                app:drawableTint="@color/text_gray" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_nav_zones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/text_gray"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/zones"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:drawableTopCompat="@drawable/ic_pin"
                android:drawablePadding="0dp"
                app:drawableTint="@color/text_gray" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/text_gray"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/profile"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:drawableTopCompat="@drawable/ic_moon"
                android:drawablePadding="0dp"
                app:drawableTint="@color/text_gray" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_nav"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Top Moon Icon Button -->
            <ImageView
                android:id="@+id/iv_moon_top"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_moon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Power Button (Converted to Card for better elevation & ripple) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fl_power_container"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="60dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/power_btn_bg"
                app:cardCornerRadius="80dp"
                app:cardElevation="12dp"
                app:rippleColor="@color/accent_pink"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    app:tint="@color/accent_pink" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Focus Status -->
            <TextView
                android:id="@+id/ll_focus_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:text="@string/focus_inactive"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/ic_unlock"
                app:drawableTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_power_container" />

            <!-- Primary Task Card Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_primary_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/ll_focus_status"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iv_task_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_work"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/accent_pink" />

                    <TextView
                        android:id="@+id/tv_task_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/design_hw"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iv_task_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_task_icon" />

                    <TextView
                        android:id="@+id/tv_task_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/primary_task"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/tv_task_label"
                        app:layout_constraintTop_toBottomOf="@id/tv_task_label" />

                    <TextView
                        android:id="@+id/tv_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/iv_pin"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_pin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Image Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_hero"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/cv_primary_task"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/night" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="22dp"
                        android:layout_marginEnd="30dp"
                        android:gravity="end"
                        android:text="@string/hero_text"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                         />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats Grid -->
            <GridLayout
                android:id="@+id/gl_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="2"
                app:layout_constraintTop_toBottomOf="@id/cv_hero">

                <!-- Time Focused Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_time_focused"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_time_focused_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/iv_chevron_1"
                            android:text="@string/time_focused"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/iv_chevron_1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            app:tint="@color/text_gray" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:text="@string/time_focused_value"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- App Blocker Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_app_blocker"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_blocker_disabled"
                            android:textColor="@color/accent_pink"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />


                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/accent_green"
                            app:strokeColor="@color/accent_green"
                            app:strokeWidth="1.5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="6dp"
                                android:text="@string/settings"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                 />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Auto-timer Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_auto_timer"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="17dp"
                        android:layout_marginStart="15dp"
                        android:text="@string/auto_timer_not_set"
                        android:textColor="@color/accent_pink"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Mode Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_mode"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_mode_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/iv_chevron_2"
                            android:text="@string/mode"
                            android:textColor="@color/text_gray"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iv_chevron_2"
                            android:layout_width="16dp"
                            android:layout_height="19dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            app:tint="@color/text_gray" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
