<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Android_Project" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_main</item>
        <item name="android:windowLightStatusBar" tools:targetApi="l">false</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_main</item>
    </style>

    <style name="Theme.Android_Project" parent="Base.Theme.Android_Project" />

    <style name="GenreChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/genre_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="checkedIconTint">@color/accent_yellow</item>
    </style>

    <style name="RoundedCornerImage">
        <item name="cornerSize">8dp</item>
    </style>
</resources>
